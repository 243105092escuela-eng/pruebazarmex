# Copia este archivo como ".env" (o como ".zarmex.env" UNA CARPETA ARRIBA de la
# carpeta del sitio, fuera de public_html: es lo más seguro) y ajusta los datos.
# Nunca subas el .env real a un repositorio.

# development = muestra errores en pantalla | production = oculta errores y los registra en logs/
APP_ENV=development

# Base de datos (valores por defecto de XAMPP/WAMP/Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zarmex
DB_USER=root
DB_PASS=

# Zona horaria usada por PHP y MySQL
APP_TZ=America/Mexico_City

# Solo si el sitio está detrás de un proxy/CDN de confianza (Cloudflare, etc.): 1
TRUST_PROXY=0

# Opcional: carpeta web donde vive el sitio si la detección automática fallara (ej. /miempresa)
APP_BASE=
